{
  "name": "@platelab/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@platelab/shared": "*",
    "@supabase/supabase-js": "2.111.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../.env --import tsx src/demo/generate.ts",
    "preflight": "node --env-file-if-exists=../.env --import tsx src/cli.ts preflight",
    "preflight:all": "node --env-file-if-exists=../.env --import tsx src/cli.ts preflight-all",
    "ingest": "node --env-file-if-exists=../.env --import tsx src/cli.ts ingest",
    "ingest:all": "node --env-file-if-exists=../.env --import tsx src/cli.ts ingest-all",
    "daemon": "node --env-file-if-exists=../.env --import tsx src/daemon.ts",
    "test": "tsx --test test/*.test.ts"
  }
}

# Public browser configuration. Use the client-safe publishable key when the
# self-hosted stack has new API keys enabled. The legacy anon key is supported
# as a fallback during the transition.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://theplatelab.studio
# Optional preview asset base for local development against a remote catalog.
# Keep NEXT_PUBLIC_SITE_URL=http://localhost:3000 for local auth redirects.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Show Google login only after the provider is enabled in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only privileged key. Prefer the new secret key. Never prefix either
# variable with NEXT_PUBLIC_ and never expose these values to browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

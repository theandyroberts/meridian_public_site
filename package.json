{
  "name": "platelab",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "workspaces": [
    "shared",
    "pipeline",
    "web"
  ],
  "scripts": {
    "demo:generate": "npm run generate -w pipeline",
    "demo:ingest": "npm run ingest:all -w pipeline",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "psql 'postgresql://postgres:postgres@127.0.0.1:54322/postgres' -v ON_ERROR_STOP=1 -f supabase/tests/0001_foundation_checks.sql && psql 'postgresql://postgres:postgres@127.0.0.1:54322/postgres' -v ON_ERROR_STOP=1 -f supabase/tests/0002_rls_access_matrix.sql",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "db:smoke:auth": "node scripts/smoke-local-auth.mjs",
    "db:staging:check": "node scripts/staging-database.mjs check",
    "db:staging:apply": "node scripts/staging-database.mjs apply",
    "staging:smoke:email": "node scripts/staging-auth-email-smoke.mjs",
    "test": "npm test -w pipeline"
  }
}
